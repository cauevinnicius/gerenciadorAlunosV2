@using Microsoft.AspNetCore.Identity;
@using GerenciadorAlunosV2.Models;
@inject SignInManager<UsuarioModel> SignInManager

@{
    ViewData["Title"] = "Página Inicial";
}

@if (SignInManager.IsSignedIn(User))
{
    <div class="container mt-4">
        <div class="mb-4">
            <h2>Bem-vindo, @User.Identity.Name!</h2>
            <p>Esta é a página inicial do Gerenciador de Alunos v2.</p>
        </div>
    </div>
    <div class="row g-4">

        <div class="col-md-4">
            <div class="card border-0 bg-primary text-white shadow-sm h-100">
                <div class="card-body p-4">
                    <h6 class="text-uppercase small fw-bold opacity-75">Alunos Matriculados</h6>
                    <h2 class="display-5 fw-bold my-2">@ViewBag.TotalAlunos</h2>
                    <a asp-controller="Aluno" asp-action="Index"
                       class="text-white text-decoration-none small opacity-75 hover-opacity-100">
                        Ver listagem completa &rarr;
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 bg-warning text-dark shadow-sm h-100">
                <div class="card-body p-4">
                    <h6 class="text-uppercase small fw-bold opacity-75">Mensalidades Pendentes</h6>
                    <h2 class="display-5 fw-bold my-2">@ViewBag.TotalPendentes</h2>
                    <a asp-controller="Mensalidade" asp-action="Index"
                       class="text-dark text-decoration-none small opacity-75">
                        Gerir cobranças &rarr;
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 bg-success text-white shadow-sm h-100">
                <div class="card-body p-4">
                    <h6 class="text-uppercase small fw-bold opacity-75">Faturamento Recebido</h6>
                    <h2 class="display-5 fw-bold my-2">@ViewBag.FaturamentoTotal.ToString("C")</h2>
                    <span class="small opacity-75">Atualizado em tempo real</span>
                </div>
            </div>
        </div>

    </div>

    <div class="mt-5 p-4 bg-light rounded shadow-sm border">
        <h4>Ações Rápidas</h4>
        <div class="mt-3">
            <a asp-controller="Aluno" asp-action="CadastrarAluno" class="btn btn-outline-dark me-2">Novo Aluno</a>
            <a asp-controller="Mensalidade" asp-action="CriarMensalidade" class="btn btn-outline-dark">Lançar
                Mensalidade</a>
        </div>
    </div>
}
else
{
    <div class="container text-center mt-5 py-5">
        <h1 class="display-4 fw-bold text-dark">Gerenciador de Alunos V2</h1>
        <p class="lead text-muted mb-4">bla bla bla bla bla bla.</p>
        <div class="d-grid gap-2 d-sm-flex justify-content-sm-center">
            <a asp-controller="Usuario" asp-action="Login" class="btn btn-primary btn-lg px-4 gap-3 fw-bold">Entrar</a>
            <a asp-controller="Usuario" asp-action="Registrar" class="btn btn-outline-secondary btn-lg px-4">Criar Conta</a>
        </div>
    </div>
}