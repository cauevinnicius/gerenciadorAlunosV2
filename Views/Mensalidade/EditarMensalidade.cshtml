
@model GerenciadorAlunosV2.ViewModels.MensalidadePerfilViewModel

@{
    ViewData["Title"] = "Editar Mensalidade";
    var alunos = ViewBag.ListaAlunos as IEnumerable<GerenciadorAlunosV2.ViewModels.AlunoPerfilViewModel>;
}

<div class="container mt-4">
    <h2>Editar Mensalidade: @Model.IdMensalidade</h2>
    <hr />

    @if (ViewBag.Erro != null)
    {
        <div class="alert alert-danger"><strong>Hmm.. algo deu errado!</strong> @ViewBag.Erro</div>
    }

    <div class="row">
        <div class="col-md-6">
            <form asp-controller="Mensalidade" asp-action="EditarMensalidade" method="post">

                <input type="hidden" asp-for="IdMensalidade" />

                <div class="mb-3">
                    @Html.LabelFor(model => model.ValorMensalidade, new { @class = "form-label" })
                    @Html.EditorFor(model => model.ValorMensalidade, new { htmlAttributes = new { @class = "form-control" } })
                </div>

                <div class="mb-3">
                    @Html.LabelFor(model => model.DataVencimento, new { @class = "form-label" })
                    @Html.EditorFor(model => model.DataVencimento, new { htmlAttributes = new { @class = "form-control" } })
                </div>

                <div class="mb-3">
                    @Html.LabelFor(model => model.Status, new { @class = "form-label" })
                    <select asp-for="Status" class="form-select"
                            asp-items="Html.GetEnumSelectList<GerenciadorAlunosV2.Enums.StatusMensalidade>()">
                        <option value="">Selecione um status</option>
                    </select>
                </div>

                <div class="mb-3">
                    @Html.LabelFor(model => model.DataPagamento, new { @class = "form-label" })
                    @Html.EditorFor(model => model.DataPagamento, new { htmlAttributes = new { @class = "form-control" } })
                </div>

                <button type="submit" class="btn btn-warning">Salvar Alterações</button>
                <a asp-action="Index" class="btn btn-secondary">Cancelar</a>

            </form>
        </div>
    </div>
</div>