@model GerenciadorAlunosV2.ViewModels.LoginViewModel

@{
    Layout = null; // Removemos o Layout padrão (menu superior, rodapé) para ser uma tela de foco puro
    ViewData["Title"] = "Criar Nova Conta";
}

<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - GerenciadorAlunos</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    
    <style>
        body {
            background-color: #f8f9fa;
            height: 100vh;
        }
        .card-registro {
            max-width: 450px;
            width: 100%;
        }
    </style>
</head>
<body class="d-flex align-items-center justify-content-center">

    <div class="card-registro p-4">
        <div class="card shadow border-0">
            <div class="card-body p-4">
                <div class="text-center mb-4">
                    <h3 class="fw-bold text-dark">Gerenciador de Alunos</h3>
                    <p class="text-muted small">Crie sua conta de acesso ao sistema</p>
                </div>

                <form asp-controller="Conta" asp-action="Registrar" method="post">
                    
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label text-secondary small fw-bold">E-mail</label>
                        <input asp-for="Email" class="form-control" placeholder="exemplo@exemplo.com" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Senha" class="form-label text-secondary small fw-bold">Senha</label>
                        <input asp-for="Senha" class="form-control" type="password" placeholder="Mínimo 8 caracteres" />
                        <span asp-validation-for="Senha" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="ConfirmarSenha" class="form-label text-secondary small fw-bold">Confirme a Senha</label>
                        <input asp-for="ConfirmarSenha" class="form-control" type="password" placeholder="Repita a senha anterior" />
                        <span asp-validation-for="ConfirmarSenha" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 fw-bold py-2 mb-3">
                        Realizar Cadastro
                    </button>

                    <div class="text-center">
                        <span class="text-muted small">Já possui uma conta?</span>
                        <a asp-action="Login" class="text-decoration-none small fw-bold">Faça Login</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</body>
</html>