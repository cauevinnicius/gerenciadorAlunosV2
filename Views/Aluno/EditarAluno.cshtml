@model GerenciadorAlunosV2.Models.AlunoModel

@{
    ViewData["Title"] = "Editar Aluno";
}

<div class="container mt-4">
    <h2>Editar Cadastro: @Model.Nome</h2>
    <hr />

    @if (ViewBag.Erro != null)
    {
        <div class="alert alert-danger">
            <strong>Hmm.. algo deu errado!</strong> @ViewBag.Erro
        </div>
    }

    <div class="row">
        <div class="col-md-6">
            <form asp-controller="Aluno" asp-action="EditarAluno" method="post">
                @* eu vou estar na tela de um editaraluno/id. Quando eu clicar pra salvar, pra garantir que farei a alteração naquel respectivo id, eu faço essa menção explícita no código, mas oculta ao usuário *@
                <input type="hidden" asp-for="Id" />

                @*aqui abaixo tem uma ideia denominada Tag Helpers, implementada no ASPNET Core. Seria para escrever html de maneira mais "pura" e "simples"*@
                <div class="mb-3">
                    <label class="form-label">Nome Completo</label>
                    <input asp-for="Nome" class="form-control" />
                </div>

                @*aqui foi a ideia que o Sérgio comentou comigo: invés de incluirmos html, mandamos o c# gerar*@
                <div class="mb-3">
                    @*se eu colocar lá no meu AlunoModel um [Display](Name = "CPF do Aluno") automaticamente o Html.LabelFor automaticamente muda - DataAnnotations*@
                    @Html.LabelFor(model => model.Cpf, new { @class = "form-label" })
                    @*o EditorFor é dinâmico. O ASPNET, se for uma string, cria uma caixa de texto; se for um datetime, um calendário; se um bool, um checkbox*@
                    @Html.EditorFor(model => model.Cpf, new { htmlAttributes = new { @class = "form-control" } })
                </div>

                <div class="mb-3">
                    <label class="form-label">E-mail</label>
                    <input asp-for="Email" type="email" class="form-control" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Celular</label>
                    <input asp-for="Celular" class="form-control" />
                </div>

                <button type="submit" class="btn btn-warning">Salvar Alterações</button>
                <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
                
            </form>
        </div>
    </div>
</div>