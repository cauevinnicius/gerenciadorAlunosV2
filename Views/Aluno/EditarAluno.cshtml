@model GerenciadorAlunosV2.ViewModels.AlunoPerfilViewModel

@{
    ViewData["Title"] = "Editar Aluno";
}

<div class="container mt-4">
    <h2>Editar Cadastro: @Model.NomeAluno</h2>
    <hr />

    @if (ViewBag.Erro != null)
    {
        <div class="alert alert-danger">
            <strong>Hmm.. algo deu errado!</strong> @ViewBag.Erro
        </div>
    }

    <div class="row">
        <div class="col-md-6">
            <form asp-controller="Aluno" asp-action="EditarAluno" method="post">
                @* eu vou estar na tela de um editaraluno/id. Quando eu clicar pra salvar, pra garantir que farei a alteração naquel respectivo id, eu faço essa menção explícita no código, mas oculta ao usuário *@
                <input type="hidden" asp-for="IdAluno" />
                @*aqui foi a ideia que o Sérgio comentou comigo: invés de incluirmos html, mandamos o c# gerar*@
                <div class="mb-3">
                    @Html.LabelFor(model => model.NomeAluno, new { @class = "form-label" })
                    @Html.EditorFor(model => model.NomeAluno, new { htmlAttributes = new { @class = "form-control" } })
                </div>

                <div class="mb-3">
                    @*se eu colocar lá no meu AlunoModel um [Display](Name = "CPF do Aluno") automaticamente o Html.LabelFor automaticamente muda - DataAnnotations*@
                    @Html.LabelFor(model => model.CpfAluno, new { @class = "form-label" })
                    @*o EditorFor é dinâmico. O ASPNET, se for uma string, cria uma caixa de texto; se for um datetime, um calendário; se um bool, um checkbox*@
                    @Html.EditorFor(model => model.CpfAluno, new { htmlAttributes = new { @class = "form-control" } })
                </div>

                <div class="mb-3">
                    @Html.LabelFor(model => model.EmailAluno, new { @class = "form-label" })
                    @Html.EditorFor(model => model.EmailAluno, new { htmlAttributes = new { @class = "form-control" } })
                </div>

                <div class="mb-3">
                    @Html.LabelFor(model => model.CelularAluno, new { @class = "form-label" })
                    @Html.EditorFor(model => model.CelularAluno, new { htmlAttributes = new { @class = "form-control" } })
                </div>

                <div class="mb-3">
                    @Html.LabelFor(model => model.DataNascimentoAluno, new { @class = "form-label" })
                    @Html.EditorFor(model => model.DataNascimentoAluno, new { htmlAttributes = new { @class = "form-control" } })
                </div>
                <div class="mb-3">
                    @Html.LabelFor(model => model.CepAluno, new { @class = "form-label"})
                    @Html.EditorFor(model => model.CepAluno, new { htmlAttributes = new { @class = "form-control" } })
                </div>
                <div class="mb-3">
                    @Html.LabelFor(model => model.RuaAluno, new { @class = "form-label"})
                    @Html.EditorFor(model => model.RuaAluno, new { htmlAttributes = new { @class = "form-control" } })
                </div>
                <div class="mb-3">
                    @Html.LabelFor(model => model.NumeroAluno, new { @class = "form-label"})
                    @Html.EditorFor(model => model.NumeroAluno, new { htmlAttributes = new { @class = "form-control" } })
                </div>
                <div class="mb-3">
                    @Html.LabelFor(model => model.ComplementoAluno, new { @class = "form-label"})
                    @Html.EditorFor(model => model.ComplementoAluno, new { htmlAttributes = new { @class = "form-control" } })
                </div>
                <div class="mb-3">
                    @Html.LabelFor(model => model.BairroAluno, new { @class = "form-label"})
                    @Html.EditorFor(model => model.BairroAluno, new { htmlAttributes = new { @class = "form-control" } })
                </div>
                <div class="mb-3">
                    @Html.LabelFor(model => model.CidadeAluno, new { @class = "form-label"})
                    @Html.EditorFor(model => model.CidadeAluno, new { htmlAttributes = new { @class = "form-control" } })
                </div>
                <div class="mb-3">
                    @Html.LabelFor(model => model.EstadoAluno, new { @class = "form-label"})
                    @Html.EditorFor(model => model.EstadoAluno, new { htmlAttributes = new { @class = "form-control" } })
                </div>
                <button type="submit" class="btn btn-warning">Salvar Alterações</button>
                <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/mascaras.js"></script>
    <script src="~/js/cep.js"></script>
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}