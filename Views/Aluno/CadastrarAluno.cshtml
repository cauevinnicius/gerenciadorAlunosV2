@model GerenciadorAlunosV2.Models.AlunoModel

@{
    ViewData["Title"] = "Cadastrar Aluno";
}

<div class="container mt-4">
    <h2>Cadastrar Novo Aluno</h2>
    <hr />

    @if (ViewBag.Erro != null)
    {
        <div class="alert alert-danger">
            <strong>Hmm.. algo deu errado!</strong> @ViewBag.Erro
        </div>
    }

    <div class="row">
        <div class="col-md-6">
            <form asp-controller="Aluno" asp-action="CadastrarAluno" method="post">
                
                <div class="mb-3">
                    <label class="form-label">Nome Completo</label>
                    <input asp-for="Nome" class="form-control" placeholder="Digite o nome..." />
                </div>

                <div class="mb-3">
                    <label class="form-label">CPF (11 dígitos)</label>
                    <input asp-for="Cpf" class="form-control" placeholder="Apenas números..." />
                </div>

                <div class="mb-3">
                    <label class="form-label">E-mail</label>
                    <input asp-for="Email" type="email" class="form-control" placeholder="exemplo@email.com" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Celular (DDD + 9 dígitos)</label>
                    <input asp-for="Celular" class="form-control" placeholder="Apenas números..." />
                </div>

                <button type="submit" class="btn btn-success">Salvar Cadastro</button>
                <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
                
            </form>
        </div>
    </div>
</div>