@model GerenciadorAlunosV2.ViewModels.AlunoPerfilViewModel

@{
    ViewData["Title"] = "Cadastrar Aluno";
}

<div class="container mt-4">
    <h2>Cadastrar Novo Aluno</h2>
    <hr />

    @if (ViewBag.Erro != null)
    {
        <div class="alert alert-danger">
            <strong>Hmm.. algo deu errado!</strong> @ViewBag.Erro
        </div>
    }

    <div class="row">
        <div class="col-md-6">
            <form asp-controller="Aluno" asp-action="CadastrarAluno" method="post">

                <div class="mb-3">
                    <label class="form-label">Nome Completo</label>
                    <input asp-for="NomeAluno" class="form-control" placeholder="Nome completo" />
                </div>

                <div class="mb-3">
                    <label class="form-label">CPF (11 dígitos)</label>
                    <input asp-for="CpfAluno" class="form-control" placeholder="000.000.000-00" />
                </div>

                <div class="mb-3">
                    <label class="form-label">E-mail</label>
                    <input asp-for="EmailAluno" type="email" class="form-control" placeholder="exemplo@email.com" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Celular (DDD + 9 dígitos)</label>
                    <input asp-for="CelularAluno" class="form-control" placeholder="Apenas números" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Data de Nascimento (DD/MM/AAAA)</label>
                    <input asp-for="DataNascimentoAluno" type="date" class="form-control" />
                </div>
                <div class="row">
                    <div class="col-md-5 mb-3">
                        <label for="Cep" class="form-label">CEP</label>
                        <input asp-for="CepAluno" type="text" name="Cep" class="form-control" maxlength="8" placeholder="Apenas numeros" />
                    </div>
                    <div class="col-md-7 mb-3">
                        <label for="Rua" class="form-label">Rua/Avenida/Travessa</label>
                        <input asp-for="RuaAluno" type="text" name="Rua" class="form-control" readonly />
                    </div>
                    <div class="col-md-5 mb-3">
                        <label for="Numero" class="form-label">Número</label>
                        <input asp-for="NumeroAluno" type="text" name="Numero" class="form-control" readonly />
                    </div>
                    <div class="col-md-7 mb-3">
                        <label for="Complemento" class="form-label">Complemento</label>
                        <input asp-for="ComplementoAluno" type="text" name="Complemento" class="form-control" readonly />
                    </div>
                    <div class="col-md-5 mb-3">
                        <label for="Bairro" class="form-label">Bairro</label>
                        <input asp-for="BairroAluno" type="text" name="Bairro" class="form-control" readonly />
                    </div>
                    <div class="col-md-5 mb-3">
                        <label for="Cidade" class="form-label">Cidade</label>
                        <input asp-for="CidadeAluno" type="text" name="Cidade" class="form-control" readonly />
                    </div>
                    <div class="col-md-2 mb-3">
                        <label for="Estado" class="form-label">UF</label>
                        <input asp-for="EstadoAluno" type="text" name="Estado" class="form-control" readonly />
                    </div>
                </div>

                <button type="submit" class="btn btn-success">Salvar Cadastro</button>
                <a asp-action="Index" class="btn btn-secondary">Cancelar</a>

            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/mascaras.js"></script>
    <script src="~/js/cep.js"></script>
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}