@* primeira coisa foi aprender o que é o razor. Depois como inserir comentários. 
basicamente é uma funcionalidade que podemos adicionar C# puro em HTML. 

a ideia seria tipo um "contrato", em que o controller precisa nos enviar uma lista (ienumerable) da minha AlunoPerfilViewModel, que contém uma versão "resumida" das informações do Aluno*@
@model IEnumerable<GerenciadorAlunosV2.ViewModels.AlunoListaViewModel>

@{
    ViewData["Title"] = "Relatório de Alunos";
}

<div class="container mt-4">
    <h2 class="mb-4">=== Relatório Geral de Alunos(as) ===</h2>
    @*é o mesmo que a href="/Aluno/CadastrarAluno"*@
    <a asp-controller="Aluno" asp-action="CadastrarAluno" class="btn btn-primary mb-3">Cadastrar Novo Aluno</a>

    <div class="table-responsive">
        <table class="table table-striped table-hover border">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Nome</th>
                    <th>CPF</th>
                    <th>E-mail</th>
                    <th>Celular</th>
                    <th>Ações</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center py-4">
                            Hmm.. parece que ainda não há alunos(as) cadastrados(as).
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var a in Model)
                    {
                        <tr>
                            <td>@a.IdAluno</td>
                            <td><a asp-controller="Aluno" asp-action="PerfilAluno" asp-route-id="@a.IdAluno" class="fw-bold text-decoration-none">@a.NomeAluno</a></td>
                            <td>@a.CpfAluno</td>
                            <td>@a.EmailAluno</td>
                            <td>@a.CelularAluno</td>
                            <td>
                                @*o asp-route-id é o q anexa o id do aluno no fim do link*@
                                <a asp-controller="Aluno" asp-action="EditarAluno" asp-route-id="@a.IdAluno" class="btn btn-sm btn-warning">Editar</a>
                                <a asp-controller="Mensalidade" asp-action="Index" asp-route-id="@a.IdAluno" class="btn btn-sm btn-info">Mensalidades</a>
                                <a asp-controller="Aluno" asp-action="DeletarAluno" asp-route-id="@a.IdAluno" class="btn btn-sm btn-danger">Deletar</a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
    <a asp-controller="Home" asp-action="Index" class="btn btn-success">Voltar</a>
</div>