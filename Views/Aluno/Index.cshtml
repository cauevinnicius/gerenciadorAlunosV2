@model IEnumerable<GerenciadorAlunosV2.Models.Aluno>

@{
    ViewData["Title"] = "Relatório de Alunos";
}

<div class="container mt-4">
    <h2 class="mb-4">=== Relatório Geral de Alunos(as) ===</h2>

    <a href="/Aluno/Cadastrar" class="btn btn-primary mb-3">Cadastrar Novo Aluno</a>

    <div class="table-responsive">
        <table class="table table-striped table-hover border">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Nome</th>
                    <th>CPF</th>
                    <th>E-mail</th>
                    <th>Celular</th>
                    <th>Ações</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center py-4">
                            Hmm.. parece que ainda não há alunos(as) cadastrados(as).
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var a in Model)
                    {
                        <tr>
                            <td>@a.Id</td>
                            <td>@a.Nome</td>
                            <td>@a.Cpf</td>
                            <td>@a.Email</td>
                            <td>@a.Celular</td>
                            <td>
                                <button class="btn btn-sm btn-warning">Editar</button>
                                <button class="btn btn-sm btn-danger">Deletar</button>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>