@model GerenciadorAlunosV2.ViewModels.AlunoPerfilViewModel

@{
    ViewData["Title"] = "Perfil do Aluno";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Ficha do Aluno: @Model.NomeAluno</h2>
        <div>
            <a asp-controller="Aluno" asp-action="EditarAluno" asp-route-id="@Model.IdAluno"
               class="btn btn-warning">Editar Cadastro</a>
            <a asp-controller="Aluno" asp-action="DeletarAluno" asp-route-id="@Model.IdAluno"
               class="btn btn-danger">Excluir Aluno</a>
            <a asp-action="Index" class="btn btn-secondary">Voltar para Lista</a>
        </div>
    </div>
    <hr />

    <div class="row mb-4">
        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-header bg-dark text-white">
                    <strong>Dados Pessoais</strong>
                </div>
                <ul class="list-group list-group-flush">
                    <li class="list-group-item"><strong>Nome: </strong> @Model.NomeAluno</li>
                    <li class="list-group-item"><strong>CPF:</strong> @Model.CpfAluno</li>
                    <li class="list-group-item"><strong>E-mail:</strong> @Model.EmailAluno</li>
                    <li class="list-group-item"><strong>Celular:</strong> @Model.CelularAluno</li>
                    <li class="list-group-item"><strong>Data de Nascimento:</strong>
                        @Model.DataNascimentoAluno.ToShortDateString()</li>
                        <li class="list-group-item"><strong>Rua:</strong> @Model.RuaAluno</li>
                        <li class="list-group-item"><strong>Número:</strong> @Model.NumeroAluno</li>
                        <li class="list-group-item"><strong>Complemento:</strong> @Model.ComplementoAluno</li>
                        <li class="list-group-item"><strong>Bairro:</strong> @Model.BairroAluno</li>
                        <li class="list-group-item"><strong>Cidade:</strong> @Model.CidadeAluno</li>
                        <li class="list-group-item"><strong>Estado (UF):</strong> @Model.EstadoAluno</li>
                        <li class="list-group-item"><strong>CEP:</strong> @Model.CepAluno</li>
                    </ul>
                </div>
            </div>
        </div>


        <div class="d-flex justify-content-between align-items-center mb-4">
            <h3 class="mn-0 text-dark">Histórico de Mensalidades</h3>
            <div class="d-flex gap-2">
                <a asp-action="Index" class="btn btn-outline-secondary shadow-sm">Voltar para Lista</a>
                <a asp-controller="Mensalidade" asp-action="LancarMensalidade" asp-route-alunoId="@Model.IdAluno"
                   class="btn btn-dark shadow-sm">+ Lançar Nova Mensalidade</a>
            </div>
        </div>

        <table class="table table-striped table-bordered text-center">
            <thead class="table-dark">
                <tr>
                    <th>ID Fatura</th>
                    <th>Valor</th>
                    <th>Vencimento</th>
                    <th>Data Pagamento</th>
                    <th>Status</th>
                    <th>Ações</th> <!-- Nova coluna para os botões -->
                </tr>
            </thead>
            <tbody>
                @if (Model.HistoricoMensalidades.Any())
                {
                    @foreach (var fatura in Model.HistoricoMensalidades)
                    {
                        <tr>
                            <td>@fatura.Id</td>
                            <td>@fatura.ValorMensalidade.ToString("C")</td>
                            <td>@fatura.DataVencimento.ToShortDateString()</td>
                            <td>@(fatura.DataPagamento?.ToShortDateString() ?? "-")</td>
                            <td>
                                <span class="badge bg-success">@fatura.Status</span>
                            </td>
                            <td>
                                <a asp-controller="Mensalidade" asp-action="EditarMensalidade" asp-route-id="@fatura.Id"
                                   class="btn btn-sm btn-warning">Editar</a>
                                <a asp-controller="Mensalidade" asp-action="DeletarMensalidade" asp-route-id="@fatura.Id"
                                   class="btn btn-sm btn-danger">Excluir</a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6">Nenhuma mensalidade registrada para este aluno.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>