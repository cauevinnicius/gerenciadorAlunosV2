@using Microsoft.AspNetCore.Identity;
@using GerenciadorAlunosV2.Models;

@inject SignInManager<UsuarioModel> SignInManager
@if (SignInManager.IsSignedIn(User))
{
    <partial name="_FuncionalidadesHeader" />
    <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
        <ul class="navbar-nav flex-grow-1">
            <li class="nav-item">
                <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Página Inicial</a>
            </li>
            <li class="nav-item">
                <a class="nav-link text-dark" asp-area="" asp-controller="Aluno" asp-action="Index">Alunos</a>
            </li>
            <li class="nav-item">
                <a class="nav-link text-dark" asp-area="" asp-controller="Mensalidade" asp-action="Index">Mensalidades</a>
            </li>
            <partial name="_LoginPartial" />
        </ul>
    </div>
}